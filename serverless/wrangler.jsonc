{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-19",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "echo-images",
    },
    {
      "bucket_name": "echo-images",
      "binding": "echo_images",
      "remote": true,
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 2000,
        "period": 60,
      },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 500,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_ROOM",
        "class_name": "UserRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["UserRoom"]
    }
  ],
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
